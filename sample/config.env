# Host paths and Docker image names.
PROJECT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
SAMPLE="$PROJECT/sample"
SIMULATION="$PROJECT/../delphisimulation"
NANOAOD="$SIMULATION/delphi-nanoaod"
CACHE="$PROJECT/.cache/sample"
OUTPUT="$PROJECT/data/20261014_jongwon"
IMAGE=delphi-analysis:local
# Native DELSIM/DELANA on this Apple Silicon Mac; generator/converter use x86.
SIM_IMAGE=gitlab-registry.cern.ch/delphi/deployment/delphi/al9_aarch64@sha256:d459268160a727e21f6566cd6167280871d2b9bd7f279ecb6d637b27110b73a1
