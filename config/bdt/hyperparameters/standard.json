{
  "name": "standard",
  "parameters": {
    "objective": "multi:softprob",
    "eval_metric": "mlogloss",
    "tree_method": "hist",
    "grow_policy": "lossguide",
    "max_depth": 0,
    "importance_type": "gain",
    "n_jobs": -1,
    "learning_rate": 0.25,
    "n_estimators": 70,
    "max_leaves": 5,
    "max_bin": 32,
    "min_child_weight": 30.0,
    "subsample": 0.7,
    "colsample_bytree": 0.4,
    "reg_alpha": 0.0,
    "reg_lambda": 1.0,
    "early_stopping_rounds": 8
  }
}
