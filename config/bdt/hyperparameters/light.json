{
  "name": "light",
  "parameters": {
    "objective": "multi:softprob",
    "eval_metric": "mlogloss",
    "tree_method": "hist",
    "grow_policy": "lossguide",
    "max_depth": 0,
    "importance_type": "gain",
    "n_jobs": -1,
    "learning_rate": 0.3,
    "n_estimators": 30,
    "max_leaves": 3,
    "max_bin": 16,
    "min_child_weight": 50.0,
    "subsample": 0.6,
    "colsample_bytree": 0.25,
    "reg_alpha": 0.0,
    "reg_lambda": 1.0,
    "early_stopping_rounds": 5
  }
}
